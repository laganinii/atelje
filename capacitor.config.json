{
  "appId": "ie.laganinii.atelje",
  "appName": "Atelje",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "backgroundColor": "#F5F1E8"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 0,
      "backgroundColor": "#F5F1E8",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native"
    }
  }
}
